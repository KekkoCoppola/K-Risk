*.aux
*.bbl
*.blg
*.log
*.out
*.toc
*.synctex.gz
*.fdb_latexmk
*.fls
*.nav
*.snm
*.vrb
docs/thesis/*.pdf
docs/thesis/main.bcf
docs/thesis/main.lof
