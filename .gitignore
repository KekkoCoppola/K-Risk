# Byte-compiled / optimized / cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Ambienti virtuali
venv/
.venv/
env/
ENV/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# Dati e dataset
# data/raw: dataset originale incluso nel repository (CC BY 4.0, fonte in data/README.md)
data/raw/*
!data/raw/Dataset for diabetes research.xlsx
!data/raw/Supplementary Information.pdf
!data/raw/.gitkeep
# data/processed e data/augmented: generati dagli script, non versionati
data/processed/*
data/augmented/*
!data/processed/.gitkeep

# Checkpoint e Pesi dei modelli
models/*.pt
models/*.pth
models/*.onnx
models/*.pkl
models/*.joblib
models/*.h5

# Output di log e tracking
logs/
wandb/
mlruns/
outputs/
results/figures/

