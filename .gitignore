# Bytecode e cache Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Ambienti virtuali
venv/
.venv/
env/
ENV/

# Checkpoint dei notebook Jupyter
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# Dati e dataset
# data/raw: dataset originale incluso nel repository (CC BY 4.0, fonte in data/README.md)
data/raw/*
!data/raw/Dataset for diabetes research.xlsx
!data/raw/Supplementary Information.pdf
# data/processed e data/augmented: generati dagli script, non versionati
data/processed/*
data/augmented/*

# Checkpoint e pesi dei modelli
models/*.pt
models/*.pth
models/*.onnx
models/*.pkl
models/**/*.joblib
models/*.h5

# Log e tracciamento degli esperimenti
logs/
wandb/
mlruns/
outputs/
results/figures/

# File di sistema e dell'IDE
.DS_Store
Thumbs.db
.vscode/
.idea/

#Paper da studiare
papers/*
# valori SHAP per le figure (rigenerabili con python -m src.models.interpretation)
analytics/phase_a/interpretation/*.npz

